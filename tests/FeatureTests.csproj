<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Casualties Unknown Demo</GamePath>
    <CorePath>$(GamePath)\BepInEx\core</CorePath>
    <ManagedPath>$(GamePath)\CasualtiesUnknown_Data\Managed</ManagedPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Compile Include="..\CasualtiesTogetherAddons\Features\*.cs" Link="Features\%(Filename)%(Extension)" />
    <Compile Include="..\CasualtiesTogetherAddons\UI\FeatureSettingsActions.cs" Link="UI\FeatureSettingsActions.cs" />
    <Compile Include="..\CasualtiesTogetherAddons\UI\ModMenuSettings.cs" Link="UI\ModMenuSettings.cs" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedPath)\UnityEngine.IMGUIModule.dll" />
    <Reference Include="BepInEx" HintPath="$(CorePath)\BepInEx.dll" />
    <Reference Include="0Harmony" HintPath="$(CorePath)\0Harmony.dll" />
    <Reference Include="MonoMod.RuntimeDetour" HintPath="$(CorePath)\MonoMod.RuntimeDetour.dll" />
    <Reference Include="MonoMod.Utils" HintPath="$(CorePath)\MonoMod.Utils.dll" />
    <Reference Include="Mono.Cecil" HintPath="$(CorePath)\Mono.Cecil.dll" />
    <Reference Include="UnityEngine" HintPath="$(ManagedPath)\UnityEngine.dll" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedPath)\UnityEngine.CoreModule.dll" />
  </ItemGroup>
</Project>
